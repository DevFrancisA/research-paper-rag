OPENAI_API_KEY=sk-...

# Leave as-is when using docker compose. For a no-Docker run, set QDRANT_URL= (empty) to use an
# embedded on-disk Qdrant in ./qdrant_local, and leave DATABASE_URL empty for in-memory caches.
QDRANT_URL=http://localhost:6333
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag

# Optional overrides (defaults shown)
# EMBEDDING_MODEL=text-embedding-3-large
# EMBEDDING_DIM=3072
# CHAT_MODEL=gpt-4.1-mini
# JUDGE_MODEL=gpt-4.1
# RERANKER_MODEL=BAAI/bge-reranker-base
# RELEVANCE_THRESHOLD=0.05
# TOP_K=5
# CANDIDATE_K=40
# RERANK_K=30
